vival."}],"organs":[],"biodist":[],"biomarkers":[],"ic50":[{"Measurement_ID":"MCTM-047082","Abbreviation_in_the_article":1,"Cell_line":"PC-9","Time(h)":72,"IC50_Dark(M*10^-6)":0.5,"IC50_Dark_value":0.5,"Method":"CCK-8","DOI":"10.1039/c3mt00040k","Year":2013,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047082","value":"0.7","numeric":0.7}},{"Measurement_ID":"MCTM-047083","Abbreviation_in_the_article":1,"Cell_line":"PC-9(CDDP)","Time(h)":72,"IC50_Dark(M*10^-6)":0.5,"IC50_Dark_value":0.5,"Method":"CCK-8","DOI":"10.1039/c3mt00040k","Year":2013,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047083","value":"12.0","numeric":12}},{"Measurement_ID":"MCTM-047084","Abbreviation_in_the_article":1,"Cell_line":"PC-14","Time(h)":72,"IC50_Dark(M*10^-6)":0.2,"IC50_Dark_value":0.2,"Method":"CCK-8","DOI":"10.1039/c3mt00040k","Year":2013,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047084","value":"0.7","numeric":0.7}},{"Measurement_ID":"MCTM-047085","Abbreviation_in_the_article":1,"Cell_line":"PC-14(CDDP)","Time(h)":72,"IC50_Dark(M*10^-6)":0.7,"IC50_Dark_value":0.7,"Method":"CCK-8","DOI":"10.1039/c3mt00040k","Year":2013,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047085","value":"18.0","numeric":18}}],"logp":[{"abbreviation_in_the_article":"5-Me","value":-1.5,"value_relation":"=","std":0.26,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.inorgchem.2c01126","year":2022,"counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","record_id":"MLDB-001913","detection":"ICP-MS","method_description":"Values of log P (partition coefficient) were determined by using the shake-flask method. (20) Each platinum complex was dissolved in ultrapure water pre-saturated overnight with n-octanol. Then, the solutions were mixed with the same volume (950 μL) of n-octanol pre-saturated with ultrapure water overnight and shaken using a shaker for 15 min in a microtube. After shaking, the mixed solutions were centrifuged at 6000g for 5 min for phase separation, and the aqueous phase was diluted 1:1000 with 5% HNO3 and used for the determination of Pt concentration (Xw) by inductively coupled plasma mass spectrometry (ICP–MS). The data acquisition and processing were conducted with an Agilent 7500 series ICP–MS MassHunter workstation (G7200A; Agilent Technologies, Santa Clara, CA, USA). The instrument settings were optimized for platinum (m/z 195). Thallium (m/z 205) was used as the internal standard. The Pt concentration of the aqueous solutions before equilibrium (Xw′) was also determined by ICP–MS using the same approach. The Pt concentration in the n-octanol phase (Xo) was calculated by subtracting Xw′ from Xw. Log P was calculated by using the following equation, log P = log{(Xw – Xw′)/Xw′}."}],"ccdc":["922832"]}