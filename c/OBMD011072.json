*10^-6)":"28 ± 1","IC50_Dark_value":28,"Method":"MTT","DOI":"10.1007/s00775-020-01809-9","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-043157","value":"22 ± 1","numeric":22}},{"Measurement_ID":"MCTM-043158","Abbreviation_in_the_article":"[Pt(cis-1,3-DACB)Cl2]","Cell_line":"CHO-K1","Time(h)":72,"IC50_Dark(M*10^-6)":"55 ± 6","IC50_Dark_value":55,"Method":"MTT","DOI":"10.1007/s00775-020-01809-9","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-043158","value":"29 ± 4","numeric":29}},{"Measurement_ID":"MCTM-043159","Abbreviation_in_the_article":"[Pt(cis-1,3-DACB)Cl2]","Cell_line":"MMC-2","Time(h)":72,"IC50_Dark(M*10^-6)":"5.8 ± 0.6","IC50_Dark_value":5.8,"Method":"MTT","DOI":"10.1007/s00775-020-01809-9","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-043159","value":"2.7 ± 0.5","numeric":2.7}}],"logp":[{"abbreviation_in_the_article":"[Pt(cis-1,3-DACB)Cl2]","value":-1.88,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"200 mM NaCl","doi":"10.1007/s00775-020-01809-9","year":2020,"record_id":"MLDB-004792","detection":"ICP-MS","method_description":"The “shake-flask” method was used to determine the logP of the investigated compounds. Octanol-saturated water (OSW) and water-saturated octanol (WSO) were prepared using analytical-grade octanol and ultrapure water. Platinum complexes were dissolved in OSW containing 200 mM NaCl. A defined volume of the solution was taken out and mixed with WSO in a volumetric ratio of 1:10. To establish the partition equilibrium, the samples were exhaustively vortexed for 30 min at room temperature. To separate the phases, the samples were centrifuged at 3000g for 5 min. The layers were separated carefully using a fine-tip pipet, and the OSW layer was then analyzed by ICP-MS for Pt content. The partition coefficients were calculated as a ratio of the concentration of the platinum in the octanol layer to that in the aqueous layer [log P = log ([Pt]WSO/[Pt]OSW)·(1/10)] = log ([Pt]stock-[Pt]OSW)/[Pt]OSW)·(1/10)]."}],"ccdc":["QAJZIP"]}