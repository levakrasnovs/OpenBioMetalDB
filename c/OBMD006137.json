IC50_Dark(M*10^-6)":1.19,"IC50_Dark_value":1.19,"Method":"MTT","DOI":"10.1021/acs.jmedchem.3c00336","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-023509","value":"27.7","numeric":27.7}},{"Measurement_ID":"MCTM-023510","Abbreviation_in_the_article":"Ir1","Cell_line":"HEK293","Time(h)":72,"IC50_Dark(M*10^-6)":5.14,"IC50_Dark_value":5.14,"Method":"MTT","DOI":"10.1021/acs.jmedchem.3c00336","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-023510","value":"24.8","numeric":24.8}}],"logp":[{"abbreviation_in_the_article":"Ir1","value":1.15,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.jmedchem.3c00336","year":2023,"counterion":"[Cl-]","record_id":"MLDB-002239","detection":"UV-Vis","method_description":"The lipophilicity (log Po/w) of Pt-Biotin, Ir1-Ir3, Ir-Pt, and IriPlatins 1–3 was determined by the conventional flask-shaking method as reported in the literature. (35) Here, log Po/w = log (Co/Cw) is defined as the logarithmic ratio of the complexes concentration in n-octanol to that in the water phase. For this, 0.5 mg of complexes was taken in 3 mL of 1:1 v/v mixture of n-octanol and water and mixed vigorously for 24 h. The mixture was then kept in a stationary state for an additional 24 h to reach saturation. The n-octanol and water phases were separated and centrifuged at 3000 rpm for 10 min, and the supernatant was isolated. The concentrations of complexes were then determined by UV–vis spectroscopy in both the n-octanol (Co) and water (Cw) phases to estimate the log Po/w values."}]}