CTM-015587","value":"16.09","numeric":16.09}},{"Measurement_ID":"MCTM-019693","Abbreviation_in_the_article":2,"Cell_line":"MG-63","Time(h)":24,"IC50_Dark(M*10^-6)":12.2,"IC50_Dark_value":12.2,"Method":"MTT","DOI":"10.1039/c8mt00369f","Year":2019,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019693","value":"39","numeric":39}},{"Measurement_ID":"MCTM-019694","Abbreviation_in_the_article":2,"Cell_line":"A549","Time(h)":24,"IC50_Dark(M*10^-6)":24.9,"IC50_Dark_value":24.9,"Method":"MTT","DOI":"10.1039/c8mt00369f","Year":2019,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019694","value":"114","numeric":114}},{"Measurement_ID":"MCTM-019695","Abbreviation_in_the_article":2,"Cell_line":"MCF-7","Time(h)":24,"IC50_Dark(M*10^-6)":20.5,"IC50_Dark_value":20.5,"Method":"MTT","DOI":"10.1039/c8mt00369f","Year":2019,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019695","value":"42","numeric":42}},{"Measurement_ID":"MCTM-019696","Abbreviation_in_the_article":2,"Cell_line":"MDA-MB-231","Time(h)":24,"IC50_Dark(M*10^-6)":15.4,"IC50_Dark_value":15.4,"Method":"MTT","DOI":"10.1039/c8mt00369f","Year":2019,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019696","value":"131","numeric":131}},{"Measurement_ID":"MCTM-019697","Abbreviation_in_the_article":2,"Cell_line":"L-929","Time(h)":24,"IC50_Dark(M*10^-6)":27.6,"IC50_Dark_value":27.6,"Method":"MTT","DOI":"10.1039/c8mt00369f","Year":2019,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019697","value":"11.2","numeric":11.2}}],"logp":[{"abbreviation_in_the_article":"3a","value":0.61,"value_relation":"=","std":0.02,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.organomet.5b00868","year":2015,"record_id":"MLDB-000919","detection":"ICP-MS","method_description":"The OECD guidelines58 for the log P determination via the shake flask method were slightly modified. A known amount of complex was suspended in water (presaturated with n-octanol) and shaken for several days on an orbital shaker. Afterward the solution was centrifuged for 5 min to allow phase separation and the ruthenium content of the saturated aqueous solution was measured by ICP-MS to give the solubility of the compounds in H2O. To obtain a partition coefficient, different ratios (0.5:1, 1:1, and 2:1) of the saturated solutions were shaken with presaturated n-octanol for 20 min on an orbital shaker. After shaking for an additional 5 min by hand and centrifugation for 5 min at 10000 rpm, the aqueous phase was collected with a syringe according to OECD guidelines. For the analysis, the samples were diluted 1:1000 with 5% HNO3 and 1 ppb of Tb was used as the internal standard (CPI international). The Ru content was determined on an Agilent 7700 ICP-MS equipped with a MicroMist nebulizer, a Scott double pass spray chamber, and an ASX500 autosampler (CETAC Technologies) in a Serie SuSi laminar flow hood (SPECTEC)."}],"ccdc":["PUYJOK"],"melting_points":[{"temperature_c":"258–259","event":"Decomposition reported","Counterion":"","source":"10.1021/acs.organomet.5b00868","source_page":"","notes":"with decomposition","url":"https://doi.org/10.1021/acs.organomet.5b00868"}]}