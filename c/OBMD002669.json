6)":13.52,"IC50_Dark_value":13.52,"Method":"MTT","DOI":"10.1021/acs.inorgchem.3c01125","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-010371","value":"15.20","numeric":15.2}}],"logp":[{"abbreviation_in_the_article":"[(η6-hmb)RuII(N^N)Cl]PF6 (Ru4)","value":2.09,"value_relation":"=","std":0.05,"type_authors":"logP","method":"shake-flask","aqueous_phase":"100 mM NaCl","temperature_C":37,"doi":"10.1021/acs.inorgchem.3c01125","year":2023,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000739","detection":"UV-Vis","method_description":"The log Pow determination of complexes Ru1-Ru4 was conducted using the shake-flask method. Octanol-saturated water (OSW) and water saturated octanol (WSO) were prepared by shaking a 1:1 mixture of 1-octanol and water for 24 h, followed by separation of each layer using a separating funnel. Stock solutions of Ru1-Ru4 (ca. 2 mM) were made in MeOH, and 50 μL was added to 4 mL of WSO containing 100 mM NaCl. 3800 μL of this solution was added to 3800 μL of OSW in a 10 mL tube and shaken for 2 h at 37 °C using an automated shaker (800 rpm). The aqueous layer was carefully separated from the octanol layer. The concentrations of tested complexes in the organic and aqueous phases were then determined using UV-vis. Log Po/w was defined as the logarithm of the ratio of the concentrations of the compound in the organic and aqueous phases (Values reported are the means of three separate determinations)."}]}