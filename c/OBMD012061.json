on_in_the_article":"S,S-DACH-Cl4-Pt(IV)","Cell_line":"L1210/DACH","Time(h)":2,"IC50_Dark(M*10^-6)":91.2,"IC50_Dark_value":91.2,"Method":"Clonogenic assay","Notes":"Colony readout (days): 10–14; Drug removed before recovery/readout; Drug exposure before removal: 2 h","DOI":"10.1097/00001813-199304000-00018","Year":1993,"Type":"IC50"},{"Measurement_ID":"MCTM-984361","Abbreviation_in_the_article":"S,S-DACH-Cl4-Pt(IV)","Cell_line":"L1210/DACH","Time(h)":72,"IC50_Dark(M*10^-6)":4.6,"IC50_Dark_value":4.6,"Method":"Coulter cell counting","Notes":"Culture medium: RPMI 1640 with 10% fetal bovine serum; Seeding density (cells/well): 100000","DOI":"10.1097/00001813-199304000-00018","Year":1993,"Type":"GI50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-984361","value":"0.83","numeric":0.83}}],"logp":[{"abbreviation_in_the_article":"(S,S)-(DACH)PtCl₄","value":-1.03,"value_relation":"=","std":0.14,"type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","doi":"10.1054/bjoc.1999.1026","year":2000,"record_id":"MLDB-002177","detection":"ICP-MS","method_description":"The hydrophobicity (log P) of the series of compounds was determined using a shake-flask method (Albert, 1979). Aqueous (0.9% (w/v) sodium chloride (NaCl) and organic (n-octanol) phases were saturated for 1 week. Drugs were dissolved at a final concentration of 300 µM in the aqueous phase. An equal volume of saturated noctanol was added and the solutions mixed for 30 min (45 rpm). Samples were centrifuged (1500 g, 10 min) and the platinum content of the organic and aqueous phases determined by ICP-MS. The log of the ratio of platinum concentrations in the organic and aqueous phases were calculated to determine log P."}]}