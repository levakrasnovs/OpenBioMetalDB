{"id":"OBMD010295","m":"Pt","n":["46"],"f":"C23H31ClN4PtS","kt":"structure","k":{"ic50":4,"logp":1},"p":1,"tgi":null,"ic":15.3,"lp":1.9,"act":[],"y":2022,"smi":"CCCCCCCCCCC1c2cccc[n]2->[Pt+2]2(<-[Cl-])<-[S-]C(=N[N]->2=1)Nc1ccccc1","iso":"","molecular_weight":626.13,"names":["46"],"salts":[],"dois":["10.1002/zaac.202200073"],"efficacy":[],"toxicity":[],"pk":[],"survival":[],"organs":[],"biodist":[],"biomarkers":[],"ic50":[{"Measurement_ID":"MCTM-039656","Abbreviation_in_the_article":46,"Cell_line":"GaMG","Time(h)":72,"IC50_Dark(M*10^-6)":6,"IC50_Dark_value":6,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039656","value":"3.4","numeric":3.4}},{"Measurement_ID":"MCTM-039657","Abbreviation_in_the_article":46,"Cell_line":"U-87 MG","Time(h)":72,"IC50_Dark(M*10^-6)":17.3,"IC50_Dark_value":17.3,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039657","value":"3.4","numeric":3.4}},{"Measurement_ID":"MCTM-039658","Abbreviation_in_the_article":46,"Cell_line":"U138","Time(h)":72,"IC50_Dark(M*10^-6)":30.6,"IC50_Dark_value":30.6,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039658","value":"1.8","numeric":1.8}},{"Measurement_ID":"MCTM-039659","Abbreviation_in_the_article":46,"Cell_line":"U343","Time(h)":72,"IC50_Dark(M*10^-6)":13.3,"IC50_Dark_value":13.3,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039659","value":"3.1","numeric":3.1}}],"logp":[{"abbreviation_in_the_article":46,"value":1.9,"value_relation":"=","std":0.45,"type_authors":"logP","method":"shake-flask","aqueous_phase":"10 mM PBS","pH":7.4,"doi":"10.1002/zaac.202200073","year":2022,"record_id":"MLDB-002064","detection":"UV-Vis","method_description":"The n-octanol/water partition coefficient logP was determined by the “shake flask” method. Equal amounts of PBS buffer (10 mM, pH 7.4) and n-octanol were mixed in a conical flask and then stirred for 72 h, followed by separation of the two phases. Then, stock solutions of the metal complexes (approx. 1 mg in 200 μL of solvent) were prepared in DMSO and 10 μL thereof mixed with 750 μL of either the water or octanol phase. After mixing on a vortexer for 15 min, the vials were centrifuged at 3000 rpm for 5 min, the two phases separated and the absorbance measured on an Agilent 8453 UV/Vis diode array spectrophotometer. LogP values were then calculated using eq. 1: logP = log(A_octanol(300 nm) / A_PBS(300 nm))"}]}