M-040161","value":"28.24 ± 3.82","numeric":28.24}},{"Measurement_ID":"MCTM-040162","Abbreviation_in_the_article":"HRP","Cell_line":"MCF-7","Time(h)":72,"IC50_Dark(M*10^-6)":"0.65 ± 0.11","IC50_Dark_value":0.65,"Method":"CCK-8","DOI":"10.1002/advs.202505567","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-040162","value":"10.20 ± 1.82","numeric":10.2}},{"Measurement_ID":"MCTM-040163","Abbreviation_in_the_article":"HRP","Cell_line":"T24","Time(h)":72,"IC50_Dark(M*10^-6)":"2.19 ± 0.13","IC50_Dark_value":2.19,"Method":"CCK-8","DOI":"10.1002/advs.202505567","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-040163","value":"28.25 ± 2.81","numeric":28.25}},{"Measurement_ID":"MCTM-040164","Abbreviation_in_the_article":"HRP","Cell_line":"A549","Time(h)":72,"IC50_Dark(M*10^-6)":"4.46 ± 0.23","IC50_Dark_value":4.46,"Method":"CCK-8","DOI":"10.1002/advs.202505567","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-040164","value":"34.72 ± 3.01","numeric":34.72}},{"Measurement_ID":"MCTM-040165","Abbreviation_in_the_article":"HRP","Cell_line":"DU145","Time(h)":72,"IC50_Dark(M*10^-6)":"3.12 ± 1.56","IC50_Dark_value":3.12,"Method":"CCK-8","DOI":"10.1002/advs.202505567","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-040165","value":"30.92 ± 1.52","numeric":30.92}},{"Measurement_ID":"MCTM-040166","Abbreviation_in_the_article":"HRP","Cell_line":"Mice hepatocyte","Time(h)":72,"IC50_Dark(M*10^-6)":"68.9 ± 1.14","IC50_Dark_value":68.9,"Method":"CCK-8","DOI":"10.1002/advs.202505567","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-040166","value":"48.6 ± 1.45","numeric":48.6}}],"logp":[{"abbreviation_in_the_article":"HRP","value":1.76,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.1002/advs.202505567","year":2025,"record_id":"MLDB-004688","detection":"UV-Vis","method_description":"The partition coefficient of the complexes was measured using the shake-flask method[4]. To prepare n-octanol saturated water, equal volumes of n-octanol and water were mixed and shaken on a mechanical shaker for 24 h at room temperature. The compounds were dissolved in n-octanol that was pre-saturated with phosphate-buffered saline (PBS, 10 mM, pH 7.4). Half of the prepared solution was then mixed with an equal volume of water-saturated n-octanol and shaken for 24 h at room temperature. The mixture was centrifuged at 2500 rpm for 15 minutes to separate the phases. The concentration of the solute in the aqueous phase was determined by spectrophotometry (λmax = 254 nm). According to the principle of mass conservation, the drug concentration in the corresponding n-octanol phase and the lipophilic-hydrophilic partition coefficient Po/w (Po/w = Co/Cw =Ao/Aw, where A stands for absorbance) were calculated using the following equation: log Po/w = log(([C]initial - [C]final)/[C]final)"}]}