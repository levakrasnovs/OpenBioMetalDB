(h)":24,"IC50_Dark(M*10^-6)":13.8,"IC50_Dark_value":13.8,"Method":"MTT","DOI":"10.1016/j.jinorgbio.2020.111099","Year":2020,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-013428","value":"11","numeric":11}},{"Measurement_ID":"MCTM-013429","Abbreviation_in_the_article":"3k","Cell_line":"HEK293","Time(h)":24,"IC50_Dark(M*10^-6)":134.8,"IC50_Dark_value":134.8,"Method":"MTT","DOI":"10.1016/j.jinorgbio.2020.111099","Year":2020,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-013429","value":"32.2","numeric":32.2}},{"Measurement_ID":"MCTM-015196","Abbreviation_in_the_article":"[Ru(η6 -p-cym)(phen)Cl]Cl","Cell_line":"MES-SA","Time(h)":72,"IC50_Dark(M*10^-6)":24,"IC50_Dark_value":24,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50"},{"Measurement_ID":"MCTM-015197","Abbreviation_in_the_article":"[Ru(η6 -p-cym)(phen)Cl]Cl","Cell_line":"MES-SA/Dx5","Time(h)":72,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50"},{"Measurement_ID":"MCTM-015198","Abbreviation_in_the_article":"[Ru(η6 -p-cym)(phen)Cl]Cl","Cell_line":"A2780","Time(h)":72,"IC50_Dark(M*10^-6)":11,"IC50_Dark_value":11,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015198","value":"2.5","numeric":2.5}},{"Measurement_ID":"MCTM-015199","Abbreviation_in_the_article":"[Ru(η6 -p-cym)(phen)Cl]Cl","Cell_line":"A2780cisR","Time(h)":72,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015199","value":"17","numeric":17}}],"logp":[{"abbreviation_in_the_article":1,"value":0.4,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":37,"doi":"10.1016/j.jinorgbio.2015.07.016","year":2015,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000391","detection":"UV-Vis","method_description":"Water–octanol partition coefficients were determined using the stir-flask method [27]. Each complex was tested in a mixture of equal volumes of water and octanol with continuous shaking for 24 h at 100 rpm and 37 °C. Then the samples were centrifuged for 5 min at 300 rpm and the organic and aqueous phases were separated. The concentration of drug in each phase was measured spectrophotometrically in order to determine values of P = [drug](in octanol)/[drug](in water). The experiments were carried out in triplicate."},{"abbreviation_in_the_article":"3k","value":0.52,"value_relation":"=","std":0.04,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.jinorgbio.2020.111099","year":2020,"counterion":"[Cl-]","record_id":"MLDB-000454","detection":"ICP-MS","method_description":"The log P of the compounds were determined via shake flask using the previously published procedure [10]. A known amount of each complex (3a-3u) was suspended in water (pre-saturated with n-octanol) and shaken for four days on an orbital shaker. To allow the phase separation, the solution was centrifuged for 10 min at 3000 rpm. Then the amount ruthenium present in saturated aqueous solution was measured by ICP-MS. To obtain the partition coefficient, different ratios (0.5 : 1, 1 : 1, and 2 : 1) of the saturated solutions were shaken with pre-saturated n-octanol for 20 min on an orbital shaker and followed the same procedure."},{"abbreviation_in_the_article":"RuP","value":-0.78,"value_relation":"=","std":0.04,"type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.1039/d5ra08313c","year":2026,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-004394","detection":"UV-Vis","method_description":"A stock solution was prepared for each Ru complex using dimethyl sulfoxide (DMSO) and diluted to 6 mL at a concentration of 50 µM using phosphate buffered saline (PBS, pH 7.4), with the final DMSO concentration being less than 5%. The absorbance spectrum was measured, then 6 mL of 1-octanol was added, and the resulting biphasic sample was mixed at room temperature for 2 hours using an IKA Trayster inversion mixer (60 rpm). Next, the aqueous layer was extracted, and its absorbance spectra was measured. Log D values were determined using the equation below with samples prepared and analyzed in triplicate: Log D7.4 = log((Abs@λmax before mixing / Abs@λmax after mixing) - 1)"}],"ccdc":["FUPGUV"],"melting_points":[{"temperature_c":"154","event":"Decomposition reported","Counterion":"F[P-](F)(F)(F)(F)F","source":"10.1016/s0022-328x(00)92679-2","source_page":"","notes":"with decomposition","url":"https://doi.org/10.1016/s0022-328x(00)92679-2"},{"temperature_c":"160–162","event":"Decomposition reported","Counterion":"[Cl-]","source":"10.1021/jacs.9b07795","source_page":"","notes":"with decomposition","url":"https://doi.org/10.1021/jacs.9b07795"}]}