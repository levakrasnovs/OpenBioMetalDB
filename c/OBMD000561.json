alue":200,"Method":"MTT","DOI":"10.1016/j.ejmech.2023.115541","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-002353","value":"15.2","numeric":15.2}},{"Measurement_ID":"MCTM-002354","Abbreviation_in_the_article":"Ru2","Cell_line":"B16","Time(h)":48,"IC50_Dark(M*10^-6)":">200","IC50_Dark_value":200,"Method":"MTT","DOI":"10.1016/j.ejmech.2023.115541","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-002354","value":"19.6","numeric":19.6}}],"logp":[{"abbreviation_in_the_article":"Ru1","value":0.475,"value_relation":"=","std":0.016,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","pH":7.26,"temperature_C":27,"doi":"10.1016/j.ejmech.2023.115541","year":2023,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-000367","detection":"UV-Vis","method_description":"The shake flash method was applied to test the octanol-water partition coefficient of the complexes in the organic and water phase [70]. In brief, 1 mg/mL of Ru1 or Ru2 was added to the mixed solvent of octanol (1 mL) and H2O (1 mL) (pH = 7.26 for Ru1 solution, 7.01 for Ru2 solution), during 24 h, the solutions were continuously shaken at 300 K. Then the solutions were centrifuged at 1000 rpm for 12 min so that the organic and aqueous phases can be separated. UV–Vis spectra was applied to determine the complex concentration in the organic phases (Co), the concentration of the complexes in the H2O phase Cw = Ctotal – Co. The mean partition coefficient P values were calculated based on Log P = log(Co/Cw)."}]}