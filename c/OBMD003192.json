.77}},{"Measurement_ID":"MCTM-012560","Abbreviation_in_the_article":"Ru3","Cell_line":"HUVEC","Time(h)":48,"IC50_Dark(M*10^-6)":11.22,"IC50_Dark_value":11.22,"Method":"MTT","DOI":"10.1021/acs.jmedchem.3c01156","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012560","value":"12.73","numeric":12.73}}],"logp":[{"abbreviation_in_the_article":"Ru3","value":1.22,"value_relation":"=","std":0.05,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":37,"doi":"10.1021/acs.jmedchem.3c01156","year":2023,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000863","detection":"UV-Vis","method_description":"The log Pow determination of complexes Ru1-Ru3 and Ir1-Ir3 was conducted using the shake-flask method. Octanol-saturated water (OSW) and water saturated octanol (WSO) were prepared by shaking a 1: 1 mixture of 1-octanol and water for 24 h, followed by separation of eachlayer using a separating funnel. Stock solutions of Ru1-Ru3 and Ir1-Ir3 (ca. 2 mM) were madein DMSO, and 50 μL was added to 4 mL of WSO. 3800 μL of this solution was added to 3800 μLof OSW in a 10 mL tube and shaken for 2 h at 37 °C using an automated shaker (800 rpm). The aqueous layer was carefully separated from the octanol layer. The concentrations of tested complexes in the organic and aqueous phases were then determined using UV-vis. Log Po/w was defined as the logarithm of the ratio of the concentrations of the compound in the organic andaqueous phases (Values reported are the means of three separate determinations)."}]}