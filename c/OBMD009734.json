t(IV)-5","Cell_line":"TE1/CDDP","IC50_Dark(M*10^-6)":2.25,"IC50_Dark_value":2.25,"Method":"not_reported","Notes":"Concentration basis: source equivalentplatinum µmol/L; Total drug-exposure duration not reported/unambiguously specified; reported phases retained","DOI":"10.1021/acsnano.4c00212","Year":2024,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-051008","value":"22.27","numeric":22.27}}],"logp":[{"abbreviation_in_the_article":"4c","value":-0.83,"value_relation":"=","std":0.12,"type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","doi":"10.1021/ja5038269","year":2014,"record_id":"MLDB-002100","detection":"GFAAS","method_description":"The log P values for 4a–e were obtained by using the shake-flask method and GFAAS. Octanol used in this experiment was pre-saturated with PBS by overnight incubation with shaking of a biphasic mixture of the two at R.T. A portion of 0.3 mL PBS containing 50 μM Pt(IV) compound (4a–e) was incubated with the pre-saturated octanol (0.3 mL) in a 1.5 mL tube. The tube was shaken at R.T. for 3 h. The two phases were separated by centrifugation and the platinum content in each phase was determined by GFAAS. Owing to the low solubility of 4e in PBS, a pre-saturated octanol solution containing 50 μM of the platinum compound was used instead. All the experiments were carried out in triplicate."}]}