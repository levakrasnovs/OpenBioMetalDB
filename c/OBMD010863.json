D011700","measurement_id":"MCTM-042254","value":">10","numeric":10}},{"Measurement_ID":"MCTM-042255","Abbreviation_in_the_article":"C4a","Cell_line":"HepG2","Time(h)":48,"IC50_Dark(M*10^-6)":1.2,"IC50_Dark_value":1.2,"Method":"MTT","DOI":"10.1016/j.molliq.2024.126622","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-042255","value":">10","numeric":10}},{"Measurement_ID":"MCTM-042256","Abbreviation_in_the_article":"C4a","Cell_line":"NCI-H460","Time(h)":48,"IC50_Dark(M*10^-6)":4.3,"IC50_Dark_value":4.3,"Method":"MTT","DOI":"10.1016/j.molliq.2024.126622","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-042256","value":">10","numeric":10}},{"Measurement_ID":"MCTM-042257","Abbreviation_in_the_article":"C4a","Cell_line":"HCT-116","Time(h)":48,"IC50_Dark(M*10^-6)":3.2,"IC50_Dark_value":3.2,"Method":"MTT","DOI":"10.1016/j.molliq.2024.126622","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-042257","value":">10","numeric":10}},{"Measurement_ID":"MCTM-042258","Abbreviation_in_the_article":"C4a","Cell_line":"HeLa","Time(h)":48,"IC50_Dark(M*10^-6)":6.8,"IC50_Dark_value":6.8,"Method":"MTT","DOI":"10.1016/j.molliq.2024.126622","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-042258","value":">10","numeric":10}},{"Measurement_ID":"MCTM-042259","Abbreviation_in_the_article":"C4a","Cell_line":"PANC-1","Time(h)":48,"IC50_Dark(M*10^-6)":8,"IC50_Dark_value":8,"Method":"MTT","DOI":"10.1016/j.molliq.2024.126622","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-042259","value":">10","numeric":10}}],"logp":[{"abbreviation_in_the_article":"C4a","value":1.15,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":25,"doi":"10.1016/j.molliq.2024.126622","year":2025,"record_id":"MLDB-001710","detection":"UV-Vis","method_description":"Following the classical shake flask method, we determined the octanol–water partition coefficients for C1a-C4a. 100 mL water (double distilled) and n-octanol (1:1) mixture was stirred vigorously for 72 h until phases were saturated, then kept to stand for one week. The aqueous phase (3 mL) was taken and (3 mL) of n-octanol was added to prepare a 1:1 mixture then the solid complex (C1a-C4a) was added in a theoretical amount to prepare a solution of 3 mM. The two-phase mixture was shaken for 10 min, and then centrifuged at 6000 rpm for 5 min at room temperature using a TDL-50B centrifuge for separation of layers and to remove all the undissolved solid complex. After centrifugation phases were separated containing dissolved amount of the complex and the extra quantity was settled down as a solid in the bottom of the centrifuge tube. 2 mL of each phase was taken carefully to avoid contamination with other phase through a syringe and subjected to UV–vis spectroscopy and the concentrations in both phases were determined by UV–Vis spectroscopy from the standard curve. All these experiments were triplicated and the mean value was calculated for each log P value. Log P values was calculated by the formula log10([complex]octanol/[complex]water)."}],"ccdc":["WUHJIW"]}