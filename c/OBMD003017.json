d_id":"OBMD011700","measurement_id":"MCTM-011688","value":"27.9","numeric":27.9}}],"logp":[{"abbreviation_in_the_article":2,"value":0.57,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","doi":"10.1016/j.jinorgbio.2023.112310","year":2023,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000518","detection":"UV-Vis","method_description":"The determination of the oil/water partition coefficient refers to the method reported in the literature [59]. Briefly, each complex (20 μM) was mixed with 2 mL PBS solution (pH = 7.2–7.4) and 2 mL n-octanol, shaken well, and sonicated for 30 min. After centrifugal separation, the absorbance of the complex in each phase was determined by a UV–Vis spectrophotometer. The absorbance is used to calculate the concentration of the respective complex according to Lambert-Beer law. The logarithmic value (lg Po/w) of the concentration ratio of the complexes in n-octanol and PBS is their oil/water partition coefficient."}]}