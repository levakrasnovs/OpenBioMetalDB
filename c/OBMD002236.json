iation_in_the_article":"1a","Cell_line":"HepG2","Time(h)":72,"IC50_Dark(M*10^-6)":">200","IC50_Dark_value":200,"Method":"MTT","DOI":"10.1016/j.biomaterials.2017.03.017","Year":2017,"Counterion":"[O-][Cl+3]([O-])([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015502","value":"13.6","numeric":13.6}},{"Measurement_ID":"MCTM-015503","Abbreviation_in_the_article":"1a","Cell_line":"A549","Time(h)":72,"IC50_Dark(M*10^-6)":93.8,"IC50_Dark_value":93.8,"Method":"MTT","DOI":"10.1016/j.biomaterials.2017.03.017","Year":2017,"Counterion":"[O-][Cl+3]([O-])([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015503","value":"18.7","numeric":18.7}},{"Measurement_ID":"MCTM-015504","Abbreviation_in_the_article":"1a","Cell_line":"HK-2","Time(h)":72,"IC50_Dark(M*10^-6)":">200","IC50_Dark_value":200,"Method":"MTT","DOI":"10.1016/j.biomaterials.2017.03.017","Year":2017,"Counterion":"[O-][Cl+3]([O-])([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015504","value":"10.3","numeric":10.3}}],"logp":[{"abbreviation_in_the_article":"Ru1","value":1.25,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.inorgchem.4c00650","year":2024,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000767","detection":"UV-Vis","method_description":"The partition coefficient of Ru1-Ru3 was determined through the shake-flask method. To prepare water-saturated octanol, 4 ml of octanol was mixed with 1 ml of water and left for 24 hours. Similarly, octanol-saturated water was prepared using the same procedure. The complex was then solubilized in 2 ml of saturated octanol by adding a minimal volume of DMSO, and this solution was added to 2 ml of saturated water. The resulting mixture underwent 24 hours of shaking using a mechanical shaker, followed by settling and separation. The concentration of the complex was subsequently assessed through UV-vis absorption spectroscopy. Partition co-efficient was calculated by the following equation, logPo/w= log([complex]octanol/[complex]water)"},{"abbreviation_in_the_article":"Ru2","value":-0.35,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","temperature_C":25,"doi":"10.1039/c5dt02446c","year":2015,"counterion":"[O-][Cl+3]([O-])([O-])[O-]","record_id":"MLDB-001094","detection":"ICP-MS","method_description":"Log Po/w is the partition coefficient between octanol and water which is determined using the flask-shaking method.32 An aliquot of a stock solution of Ru1–Ru3 in 100 mM aqueous NaCl (0.9% w/v to prevent aqueous interaction and remain saturated with octanol) was added to an equal volume of octanol (saturated with 0.9% NaCl w/v). The mixture was shaken overnight at 60 rpm at 298 K to allow partitioning. After the sample was centrifuged at 3000 rpm for 10 min, the aqueous layer was carefully separated from the octanol layer for ruthenium analysis. The Ru concentration in the aqueous phase was determined using ICP-MS and used to calculate the [Ru]o/[Ru]w ratio."}],"ccdc":["WOQXEJ"]}