096","Abbreviation_in_the_article":"IrL2","Cell_line":"HCT-116","Time(h)":48,"IC50_Dark(M*10^-6)":1.6,"IC50_Dark_value":1.6,"Method":"MTT","DOI":"10.1002/smll.202406809","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-024096","value":"5.38","numeric":5.38}},{"Measurement_ID":"MCTM-024097","Abbreviation_in_the_article":"IrL2","Cell_line":"HEK293","Time(h)":48,"IC50_Dark(M*10^-6)":0.96,"IC50_Dark_value":0.96,"Method":"MTT","DOI":"10.1002/smll.202406809","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-024097","value":"2.66","numeric":2.66}}],"logp":[{"abbreviation_in_the_article":"IrL2","value":0.24,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","temperature_C":37,"doi":"10.1002/smll.202406809","year":2024,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-003912","detection":"ICP-MS","method_description":"The flask-shaking method and ICP-MS analysis were utilized to determine the lipophilicity (log Po/w) of Ir(III) complexes. An equivalent amount of 0.9% (w/v) NaCl solution, saturated with octanol, was introduced into a 1 mL stock solution of the Ir(III) complexes in n-octanol. The resulting mixture was agitated for 24 h in an incubator set at 37 °C. Following this, the mixtures underwent centrifugation at 4000 × rpm for 10 min. Subsequently, the distinct oil and water phases were carefully isolated. A total of 100 µL from each of the oil and water phases were subjected to dissolution using 65% HNO3 (300 µL) and subsequently diluted to a final volume of 10 mL using distilled water. The concentration of Ir(III) (Co or Cw) was determined via the ICP-MS technique utilizing an internal reference. The Po/w value is directly proportional to the ratio of the concentration of the organic phase (Co) to the attention of the aqueous phase (Cw)."}]}