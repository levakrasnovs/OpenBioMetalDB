PTA-C","Cell_line":"HBL-100","Time(h)":72,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1021/jm070039f","Year":2007,"Type":"IC50"},{"Measurement_ID":"MCTM-015499","Abbreviation_in_the_article":"RAPTA-C","Cell_line":"A2780","Time(h)":72,"IC50_Dark(M*10^-6)":353,"IC50_Dark_value":353,"Method":"MTT","DOI":"10.1021/om900345n","Year":2009,"Type":"IC50"},{"Measurement_ID":"MCTM-015924","Abbreviation_in_the_article":10,"Cell_line":"A2780","Time(h)":72,"IC50_Dark(M*10^-6)":251,"IC50_Dark_value":251,"Method":"MTT","DOI":"10.1021/jm5002748","Year":2014,"Type":"IC50"},{"Measurement_ID":"MCTM-015925","Abbreviation_in_the_article":10,"Cell_line":"HEK293","Time(h)":72,"IC50_Dark(M*10^-6)":">500","IC50_Dark_value":500,"Method":"MTT","DOI":"10.1021/jm5002748","Year":2014,"Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"RAPTA-C","value":-1.36,"value_relation":"=","std":0.06,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1002/elps.201700443","year":2018,"record_id":"MLDB-000214","detection":"ICP-MS","method_description":"The shake flask procedure outlined previously 28, 46 was followed for the determination of solubility and log P values. A saturated solution of complex was suspended in H2O (pre-saturated with n-octanol) and shaken for 4 days on an orbital shaker. The solution was centrifuged for 5 min at 2000 rpm prior to aqueous aliquots being collected for total Ru concentration analysis, and partition experiments with n-octanol (pre-saturated with H2O) at three ratios (2:1, 1:1, and 0.5:1). After 30 min incubation time on an orbital shaker, the samples were shaken by hand for an additional 5 min and were then centrifuged at 10 000 rpm for 5 min. The aqueous layer was collected with a syringe and diluted 1:100 in 5% HNO3. The ruthenium content was measured via direct infusion through an ASX-500 autosampler (CETAC technologies) in a Serie SuSi laminar flow hood (SPECTEC) into an Agilent 7700 ICP-MS, equipped with a MicroMist nebulizer and a Scott double pass spray chamber. All analysis were carried out in triplicate unless otherwise specified."}],"ccdc":["RAKMIZ"]}