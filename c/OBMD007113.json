numeric":7.6}}],"logp":[{"abbreviation_in_the_article":"IrCp-DCA","value":0.31,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":37,"doi":"10.1016/j.jinorgbio.2026.113317","year":2026,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000571","detection":"UV-Vis","method_description":"The n-octanol/water partition coefficient (log Po/w) of complexes IrCp-bpy, IrCp-DCA, Ir-NH₂, and Ir-DCA was determined by the shake-flask method. The complexes were dissolved in the aqueous phase saturated with n-octanol, and an equal volume of the organic phase saturated with water was added and mixed uniformly. The mixture was shaken overnight at 37 °C and 800 rpm, then centrifuged at 8000 rpm for 8 min. The absorbance of the complexes in the organic and aqueous phases was detected using a UV–vis spectrophotometer, and the log Po/w value was calculated."}]}