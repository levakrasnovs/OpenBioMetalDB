n":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50"},{"Measurement_ID":"MCTM-037504","Abbreviation_in_the_article":1,"Cell_line":"A549","Time(h)":72,"IC50_Dark(M*10^-6)":"0.029 ± 0.003","IC50_Dark_value":0.029,"Method":"MTS (CellTiter 96 AQueous)","DOI":"10.1016/j.ica.2019.04.030","Year":2019,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50"},{"Measurement_ID":"MCTM-038246","Abbreviation_in_the_article":"1′′′","Cell_line":"NCI-H460","Time(h)":72,"IC50_Dark(M*10^-6)":0.0013,"IC50_Dark_value":0.0013,"Method":"MTS","DOI":"10.1002/chem.201404675","Year":2014,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50"},{"Measurement_ID":"MCTM-038247","Abbreviation_in_the_article":"1′′′","Cell_line":"A549","Time(h)":72,"IC50_Dark(M*10^-6)":0.0039,"IC50_Dark_value":0.0039,"Method":"MTS","DOI":"10.1002/chem.201404675","Year":2014,"Counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"1′′′","value":-0.98,"value_relation":"=","std":0.19,"type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","temperature_C":25,"doi":"10.1002/chem.201404675","year":2014,"counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","record_id":"MLDB-002120","detection":"UV-Vis","method_description":"To obtain octanol-saturated water and water-saturated octanol, 100 mL of PBS was stirred with 100 mL of octanol for 24 h, followed by centrifugation for 5 min. The platinum complexes were dissolved in 1.0 mL of octanol-saturated PBS to a typical concentration of 0.1 mM and then mixed with 1.0 mL water-saturated octanol. Triplicates of each experiment were mixed in a multi-tube vortexer incubator for 16 h at room temperature and then centrifuged for 5 min. The layers were separated carefully, and the content of platinum–acridines was determined spectrophotometrically at 413 nm (with ε413=10 000 M-1 cm-1 in octanol-saturated PBS and ε413=8600 M-1 cm-1 in PBS-saturated octanol). The partition coefficients (D) of the samples were then determined as the quotient of the concentration of compound in octanol and the concentration in the aqueous layer. Reported logD values are the mean ±standard deviations of three determinations."},{"abbreviation_in_the_article":1,"value":-1.04,"value_relation":"=","std":0.16,"type_authors":"logD","method":"shake-flask","aqueous_phase":"0.9% NaCl","pH":5.8,"doi":"10.1016/j.ica.2019.04.030","year":2019,"counterion":"O=[N+]([O-])[O-].O=[N+]([O-])[O-]","record_id":"MLDB-002168","detection":"UV-Vis","method_description":"To determine the log D values for compounds 1, 2, and 4, their partitioning between 0.9% saline (pH 5.8) and 1-octanol was assessed spectrophotometrically. Extractions and absorbance measurements were performed with 50 µM solutions in saline, saturated with 1-octanol for 16 h, on a Cary 100 UV–visible spectrophotometer (Agilent Technologies) at λmax = 413 nm with ε413 = 104 M-1 cm-1. Equal volumes of saline solution and 1-octanol were vortexed at room temperature until a constant absorbance reading was obtained (approximately 10 min). The values were calculated using Eq. (1) and are reported as averages of a minimum of three determinations."}]}