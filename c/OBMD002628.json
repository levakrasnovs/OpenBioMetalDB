18","Abbreviation_in_the_article":1,"Cell_line":"Vero","Time(h)":24,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":50,"Method":"MTT","DOI":"10.3390/ijms241511896","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012418","value":"33.7","numeric":33.7}},{"Measurement_ID":"MCTM-012419","Abbreviation_in_the_article":1,"Cell_line":"EA.hy926","Time(h)":24,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":50,"Method":"MTT","DOI":"10.3390/ijms241511896","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012419","value":"22.9","numeric":22.9}},{"Measurement_ID":"MCTM-012420","Abbreviation_in_the_article":1,"Cell_line":"HepG2","Time(h)":24,"IC50_Dark(M*10^-6)":30.1,"IC50_Dark_value":30.1,"Method":"MTT","DOI":"10.3390/ijms241511896","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012420","value":"49.1","numeric":49.1}},{"Measurement_ID":"MCTM-012421","Abbreviation_in_the_article":1,"Cell_line":"T24","Time(h)":24,"IC50_Dark(M*10^-6)":11.7,"IC50_Dark_value":11.7,"Method":"MTT","DOI":"10.3390/ijms241511896","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012421","value":">50","numeric":50}}],"logp":[{"abbreviation_in_the_article":5,"value":1.12,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":37,"doi":"10.1016/j.jinorgbio.2015.07.016","year":2015,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000395","detection":"UV-Vis","method_description":"Water–octanol partition coefficients were determined using the stir-flask method [27]. Each complex was tested in a mixture of equal volumes of water and octanol with continuous shaking for 24 h at 100 rpm and 37 °C. Then the samples were centrifuged for 5 min at 300 rpm and the organic and aqueous phases were separated. The concentration of drug in each phase was measured spectrophotometrically in order to determine values of P = [drug](in octanol)/[drug](in water). The experiments were carried out in triplicate."},{"abbreviation_in_the_article":1,"value":2.75,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.45% NaCl","temperature_C":37,"doi":"10.3390/ijms241511896","year":2023,"counterion":"[Cl-]","record_id":"MLDB-001491","detection":"UV-Vis","method_description":"The shake-flask method was used to measure Log p of 1–7. n-octanol and water containing 0.45% of sodium chloride were mutual saturated by stirring at 250 rpm for 24 h. The complex was dissolved in a mixture with equal volumes of pre-saturated n-octanol and water to a final concentration of 0.5 mM. The mixture was shaken at 250 rpm for 24 h at 37 °C and then centrifuged at 3000 rpm for 10 min. The complex concentration (C) in each phase was measured by UV-Vis spectroscopy and used to calculate Log p, according to the formula Log p = log (Coctanol/Cwater)."},{"abbreviation_in_the_article":"RuBtB","value":0.84,"value_relation":"=","std":0.03,"type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.3390/biom15040475","year":2025,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-004460","detection":"UV-Vis","method_description":"A stock solution was prepared from each Ru complex using dimethyl sulfoxide (DMSO), then diluted to 6 mL and a concentration of 50 μM using phosphate-buffered saline (PBS, pH 7.4), where the final DMSO concentration was less than 5%. The absorbance spectra were measured, then 6 mL of 1-octanol was added, and the resulting biphasic sample was mixed at room temperature for 2 h using an IKA Trayster inversion mixer (60 rpm). Following this, the aqueous layer was extracted, and its absorbance spectra were measured. Log D values were determined using the equation below: LogD7.4 = log((Abs@λmax before mixing / Abs@λmax after mixing) - 1)"}],"ccdc":["FUPGOP"]}