{"id":"OBMD010290","m":"Pd","n":["37"],"f":"C21H27ClN4PdS","kt":"structure","k":{"ic50":4,"logp":1},"p":1,"tgi":null,"ic":15.9,"lp":1.59,"act":[],"y":2022,"smi":"CCCCCCCCC1c2cccc[n]2->[Pd+2]2(<-[Cl-])<-[S-]C(=N[N]->2=1)Nc1ccccc1","iso":"","molecular_weight":509.42,"names":["37"],"salts":[],"dois":["10.1002/zaac.202200073"],"efficacy":[],"toxicity":[],"pk":[],"survival":[],"organs":[],"biodist":[],"biomarkers":[],"ic50":[{"Measurement_ID":"MCTM-039640","Abbreviation_in_the_article":37,"Cell_line":"GaMG","Time(h)":72,"IC50_Dark(M*10^-6)":12,"IC50_Dark_value":12,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039640","value":"3.4","numeric":3.4}},{"Measurement_ID":"MCTM-039641","Abbreviation_in_the_article":37,"Cell_line":"U-87 MG","Time(h)":72,"IC50_Dark(M*10^-6)":16.4,"IC50_Dark_value":16.4,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039641","value":"3.4","numeric":3.4}},{"Measurement_ID":"MCTM-039642","Abbreviation_in_the_article":37,"Cell_line":"U138","Time(h)":72,"IC50_Dark(M*10^-6)":19,"IC50_Dark_value":19,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039642","value":"1.8","numeric":1.8}},{"Measurement_ID":"MCTM-039643","Abbreviation_in_the_article":37,"Cell_line":"U343","Time(h)":72,"IC50_Dark(M*10^-6)":15.4,"IC50_Dark_value":15.4,"Method":"MTT","DOI":"10.1002/zaac.202200073","Year":2022,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-039643","value":"3.1","numeric":3.1}}],"logp":[{"abbreviation_in_the_article":37,"value":1.59,"value_relation":"=","std":0.09,"type_authors":"logP","method":"shake-flask","aqueous_phase":"10 mM PBS","pH":7.4,"doi":"10.1002/zaac.202200073","year":2022,"record_id":"MLDB-002059","detection":"UV-Vis","method_description":"The n-octanol/water partition coefficient logP was determined by the “shake flask” method. Equal amounts of PBS buffer (10 mM, pH 7.4) and n-octanol were mixed in a conical flask and then stirred for 72 h, followed by separation of the two phases. Then, stock solutions of the metal complexes (approx. 1 mg in 200 μL of solvent) were prepared in DMSO and 10 μL thereof mixed with 750 μL of either the water or octanol phase. After mixing on a vortexer for 15 min, the vials were centrifuged at 3000 rpm for 5 min, the two phases separated and the absorbance measured on an Agilent 8453 UV/Vis diode array spectrophotometer. LogP values were then calculated using eq. 1: logP = log(A_octanol(300 nm) / A_PBS(300 nm))"}]}