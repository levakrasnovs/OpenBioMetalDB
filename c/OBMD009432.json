MCTM-048035","Abbreviation_in_the_article":"O2","Cell_line":"A549","Time(h)":48,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":">50","Method":"MTT","DOI":"10.1039/d0dt03194a","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-048035","value":"13.5","numeric":13.5}},{"Measurement_ID":"MCTM-048036","Abbreviation_in_the_article":"O2","Cell_line":"A549cisR","Time(h)":48,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":">50","Method":"MTT","DOI":"10.1039/d0dt03194a","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-048036","value":"22.6","numeric":22.6}},{"Measurement_ID":"MCTM-048037","Abbreviation_in_the_article":"O2","Cell_line":"HEK293T","Time(h)":48,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":">50","Method":"MTT","DOI":"10.1039/d0dt03194a","Year":2020,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-048037","value":"9.4","numeric":9.4}}],"logp":[{"abbreviation_in_the_article":"1b","value":-2.25,"value_relation":"=","std":0.07,"type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.1021/acs.inorgchem.8b00706","year":2018,"record_id":"MLDB-002126","detection":"ICP-OES","method_description":"A shake-flask method was used to determine the log P values of the platinum complexes. Five micromoles of platinum complexes were dissolved in 2 mL of PBS buffer (pH = 7.4); a 0.5 mL solution of these platinum complexes was mixed with 0.5 mL of octanol that was presaturated with PBS buffer (pH = 7.4). The two phases were shaken at room temperature for 8 h and then separated by centrifugation. The platinum content in the two phases was determined by ICP-OES. The log P values were calculated from an average of three independent measurements."},{"abbreviation_in_the_article":"I","value":-2.38,"value_relation":"=","std":0.19,"type_authors":"logP","method":"shake-flask","aqueous_phase":"200 mM NaCl","temperature_C":25,"doi":"10.1016/j.jinorgbio.2014.07.004","year":2014,"record_id":"MLDB-002162","detection":"FAAS","method_description":"To determine the partition coefficient (P) the shake flask method was used. 1-Octanol-saturated water (OSW) and water-saturated 1-octanol (WSO) were prepared using analytical grade 1-octanol and 0.2 M aqueous NaCl solution (to suppress hydrolysis of the chlorido complexes). Mixing was done by vortexing for 30 min at room temperature to establish the partition equilibrium. To separate the phases, centrifugation was done at 3000 g for 5 min. The aqueous layer was carefully separated from the 1-octanol layer for platinum analysis. Pt was quantified from aliquots taken from the 1-octanol-saturated aqueous samples before and after partition by FAAS. Partition coefficients of Pt complexes were calculated using the equation log P = log([Pt]WSO / [Pt]OSW)."}]}