iation_in_the_article":"Ir3","Cell_line":"BEAS-2B","Time(h)":24,"IC50_Dark(M*10^-6)":41.85,"IC50_Dark_value":41.85,"Method":"MTT","DOI":"10.1016/j.bioorg.2025.108507","Year":2025,"Counterion":"O=S(=O)([O-])C(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-024079","value":"32.01","numeric":32.01}}],"logp":[{"abbreviation_in_the_article":"Ir3","value":1.91,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"temperature_C":25,"doi":"10.1016/j.bioorg.2025.108507","year":2025,"counterion":"O=S(=O)([O-])C(F)(F)F","record_id":"MLDB-000284","detection":"UV-Vis","method_description":"The lipophilicity (Po/w) of iridium complexes Ir1-Ir4 were determined by shake flask method. The n-octanol (20 ml) and PBS (20 ml) were shaked together at 25°C and 120 r/min for 24 h to allow saturation of both phases. Iridium complexes Ir1-Ir4 (20 μL, 10 mM) were dissolved in 2 ml of PBS saturated with n-octanol, and then added to an equal amount of n-octanol saturated with PBS. The mixture was shaked at 25°C and 120 r/min for 6 h. After the two phases were separated, the concentrations of these complexes in the organic and aqueous phases were determined using UV-vis spectrophotometer. LogPo/w was defined as the logarithmic ratio of the concentrations of Ir1-Ir4 in the organic and aqueous phase."}]}