pound_id":"OBMD011700","measurement_id":"MCTM-006863","value":"42.1","numeric":42.1}},{"Measurement_ID":"MCTM-006864","Abbreviation_in_the_article":"2a","Cell_line":"HL-7702 (L-02)","Time(h)":72,"IC50_Dark(M*10^-6)":85.3,"IC50_Dark_value":85.3,"Method":"CellTiter-Glo","DOI":"10.1002/chem.201404922","Year":2014,"Counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-006864","value":"7.3","numeric":7.3}}],"logp":[{"abbreviation_in_the_article":"2a","value":-0.85,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","temperature_C":25,"doi":"10.1002/chem.201404922","year":2014,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-003377","detection":"ICP-MS","method_description":"Lipophilicity was expressed in terms of log Po/w values, which were determined by the flask-shaking method. An aliquot of a stock solution of the ruthenium complex in aqueous NaCl (0.9 % w/v and saturated with octanol) was added to an equal volume of octanol (saturated with 0.9 % NaCl w/v), and the mixture was shaken overnight at 60 rpm at 298 K to allow partitioning. After centrifuging the sample at 3000 rpm for 10 min, the aqueous layer was carefully separated from the octanol layer for ruthenium analysis. The Ru concentration in the aqueous phase was determined by ICP-MS and used to calculate the [Ru]o/[Ru]w ratio."}]}