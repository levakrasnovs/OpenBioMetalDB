73,"IC50_Dark(M*10^-6)":">25","IC50_Dark_value":25,"Method":"MTT","DOI":"10.1021/acs.inorgchem.1c02796","Year":2021,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-040547","Abbreviation_in_the_article":2,"Cell_line":"MCF-10A","Time(h)":73,"IC50_Dark(M*10^-6)":">25","IC50_Dark_value":25,"Method":"MTT","DOI":"10.1021/acs.inorgchem.1c02796","Year":2021,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-043891","Abbreviation_in_the_article":"RuAA","Cell_line":"MCF-7","Time(h)":30,"IC50_Dark(M*10^-6)":19.42,"IC50_Dark_value":19.42,"Method":"CCK-8","Notes":"Formulation: free complex","DOI":"10.1002/adma.202523608","Year":2026,"Counterion":"[Cl-]","Type":"IC50"},{"Measurement_ID":"MCTM-043892","Abbreviation_in_the_article":"RuAA","Cell_line":"4T1","Time(h)":30,"IC50_Dark(M*10^-6)":12.45,"IC50_Dark_value":12.45,"Method":"CCK-8","Notes":"Formulation: free complex","DOI":"10.1002/adma.202523608","Year":2026,"Counterion":"[Cl-]","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":1,"value":-1.1,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1002/ejic.202100468","year":2021,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000202","detection":"UV-Vis","method_description":"The lipophilicity of 1–3 and 5–8 was measured using the shake-flask method, following a previously reported procedure.32 Briefly, complexes were dissolved in 0.5 mL of n-octanol presaturated with water to give 100 μM solutions, and 0.5 mL water presaturated with n-octanol was added. The mixture was vigorously shaken 200× by hand. The layers were allowed to stand and separate over 24 h. The layers were separated, and each phase was analyzed for the presence of compound by UV/vis spectroscopy. Each experiment was carried out in triplicate."},{"abbreviation_in_the_article":2,"value":-0.17,"value_relation":"=","std":0.04,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.inorgchem.1c02796","year":2021,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-004786","detection":"UV-Vis","method_description":"Solutions of complexes 1–7 (3 mL, 40 μM) were prepared in octanol. To the same container, 3 mL of deionized water was added. The containers were shaken vigorously for 5 min and allowed to settle overnight for complete separation of water and octanol layers. Three absorbance readings of both the octanol and water layers were then collected for each complex. The log P value of each complex was finally determined by taking the log of the ratio of the mean absorbance in the octanol layer to the mean absorbance in the water layer."}],"ccdc":["UBUGOR"]}