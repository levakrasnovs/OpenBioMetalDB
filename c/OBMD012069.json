od":"acid phosphatase (APH)","Notes":"Culture dimensionality: 3D","DOI":"10.1039/c7dt01054k","Year":2017,"Counterion":"O=C([O-])C(F)(F)F.O=C([O-])C(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047553","value":"81.00","numeric":81}},{"Measurement_ID":"MCTM-047572","Abbreviation_in_the_article":"VI","Cell_line":"LoVo","Time(h)":72,"IC50_Dark(M*10^-6)":0.97,"IC50_Dark_value":0.97,"Method":"MTT","Notes":"Culture dimensionality: 2D","DOI":"10.1039/c7dt01054k","Year":2017,"Counterion":"O=C([O-])C(F)(F)F.O=C([O-])C(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-047573","Abbreviation_in_the_article":"VI","Cell_line":"LoVo OXP","Time(h)":72,"IC50_Dark(M*10^-6)":1.14,"IC50_Dark_value":1.14,"Method":"MTT","Notes":"Culture dimensionality: 2D","DOI":"10.1039/c7dt01054k","Year":2017,"Counterion":"O=C([O-])C(F)(F)F.O=C([O-])C(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-047587","Abbreviation_in_the_article":"VI","Cell_line":"HEK293","Time(h)":72,"IC50_Dark(M*10^-6)":7.62,"IC50_Dark_value":7.62,"Method":"MTT","Notes":"Culture dimensionality: 2D","DOI":"10.1039/c7dt01054k","Year":2017,"Counterion":"O=C([O-])C(F)(F)F.O=C([O-])C(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-047587","value":"14.28","numeric":14.28}}],"logp":[{"abbreviation_in_the_article":6,"value":-1.37,"value_relation":"=","std":0.05,"type_authors":"logP","method":"shake-flask","aqueous_phase":"200 mM NaCl","temperature_C":25,"doi":"10.1021/acs.jmedchem.9b00489","year":2019,"record_id":"MLDB-002198","detection":"FAAS","method_description":"To determine the partition coefficients (P) of the investigated compounds, the “shake flask” method was used. Octanol-saturated water (OSW) and watersaturated octanol (WSO) were prepared using analytical grade octanol and ultrapure water. Platinum complexes were dissolved in OSW containing 200 mM NaCl and mixed with WSO in volumetric ratios of 2:1, 1:1, and 1:2. Mixing was done by vortexing for 30 min at room temperature to establish the partition equilibrium. To separate the phases, the samples were centrifuged at 3000g for 5 min. The layers were separated carefully using a fine-tip pipet and then analyzed for metal content by FAAS. The partition coefficients were calculated as a ratio of the concentration of the compound in the octanol layer to that in the aqueous layer [log P = log ([Pt]WSO/[Pt]OSW)]."}]}