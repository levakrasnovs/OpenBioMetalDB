)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1016/j.csbj.2018.11.010","Year":2019,"Counterion":"[O-][Cl+3]([O-])([O-])[O-].[O-][Cl+3]([O-])([O-])[O-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-017421","value":"7.1","numeric":7.1}}],"logp":[{"abbreviation_in_the_article":"4a","value":-0.63,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","temperature_C":25,"doi":"10.1002/chem.201404922","year":2014,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-003379","detection":"ICP-MS","method_description":"Lipophilicity was expressed in terms of log Po/w values, which were determined by the flask-shaking method. An aliquot of a stock solution of the ruthenium complex in aqueous NaCl (0.9 % w/v and saturated with octanol) was added to an equal volume of octanol (saturated with 0.9 % NaCl w/v), and the mixture was shaken overnight at 60 rpm at 298 K to allow partitioning. After centrifuging the sample at 3000 rpm for 10 min, the aqueous layer was carefully separated from the octanol layer for ruthenium analysis. The Ru concentration in the aqueous phase was determined by ICP-MS and used to calculate the [Ru]o/[Ru]w ratio."},{"abbreviation_in_the_article":3,"value":-0.91,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","doi":"10.1111/php.12378","year":2014,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-005056","detection":"UV-Vis","method_description":"The n-Octanol/water partition coefficients (logP) were determined using equal volumes of PBS and 1-octanol. Final concentrations of the complexes in aqueous and organic phases were determined by measuring the absorption spectra."}]}