41703","value":"5.3 ± 0.4","numeric":5.3}}],"logp":[{"abbreviation_in_the_article":"C4","value":-0.35,"value_relation":"=","std":0.04,"type_authors":"logD","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acsorginorgau.6c00026","year":2026,"record_id":"MLDB-004945","detection":"UV-Vis","method_description":"The partition coefficients of Ir(III) complexes were determined by standard “shake flask” method as previously described. (37) Octanol-saturated water (OSW) and water-saturated octanol (WSO) were prepared using analytical grade 1-octanol and ultrapure water. Then, 2 mL of 25 μg/mL of complex in WSO were shaken with 2 mL of OSW at 1500 rpm for 6 h at room temperature. The organic phases were collected by centrifugation (4000 rpm, 10 min, r.t.). The absorbance of WSO phase before and after shaking was measured. The distribution coefficients (log Do/w) of the complexes were obtained from the ratio of the complexes present in 1-octanol before and after shaking (eq 2). Each experiment was repeated three times."}],"ccdc":["NAMLUN"]}