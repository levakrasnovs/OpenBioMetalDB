h)":72,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":50,"Method":"MTT","DOI":"10.1007/s00775-014-1214-6","Year":2014,"Type":"IC50"},{"Measurement_ID":"MCTM-039410","Abbreviation_in_the_article":2,"Cell_line":"CT26.WT","Time(h)":72,"IC50_Dark(M*10^-6)":">50","IC50_Dark_value":50,"Method":"MTT","DOI":"10.1007/s00775-014-1214-6","Year":2014,"Type":"IC50"}],"logp":[{"abbreviation_in_the_article":2,"value":0.77,"value_relation":"=","std":0.06,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1007/s00775-014-1214-6","year":2014,"record_id":"MLDB-001989","detection":"ICP-MS","method_description":"Lipophilicity was determined as the partition coefficient between n-octanol and water (log P o/w) and as the chromatographic retention factor (log k w). The log P o/w determination was carried out according to the OECD guidelines for the classical shake flask method [23] with slight modifications. The complexes were dissolved in Milli-Q water (pre-saturated with 1-octanol) and the platinum concentration was determined by ICP-MS. The remaining stock solution was mixed with an equal volume of 1-octanol (pre-saturated with Milli-Q water) and shaken for 1 h. After phase separation, the platinum concentration was again determined in the aqueous phase by ICP-MS and the partition coefficients were calculated assuming the missing quantity (compared to the stock solution) in the organic phase. ICP-MS measurements were carried out after dilution of the samples with 1 % HNO3 using the instrumental parameters given in Table 1."}]}