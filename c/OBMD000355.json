50"}],"logp":[{"abbreviation_in_the_article":"Ru2","value":-0.14,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.ejmech.2022.114312","year":2022,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000357","detection":"ICP-MS","method_description":"Lipophilicity (log Po/w) was measured by the shake-flask method similar to that reported in the literature [76]. In short, equal amounts of noctanol and doubly distilled water were added to 2 mg Ru1, Ru2, Ru3 and Ru4, respectively, and then violently vortexed for 24 h. The noctanol and doubly distilled water phases were collected carefully, and the samples were subsequently digested with 70% HNO3 and 30% H2O2 overnight. The ruthenium concentration (Co or Cw) was detected by ICP-MS after diluting 1:100 using doubly distilled water. The Po/w values are equivalent to Co/Cw."}]}