surement_ID":"MCTM-026911","Abbreviation_in_the_article":"ER-Ir","Cell_line":"HLF","Time(h)":48,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"CCK-8","DOI":"10.1021/acs.jmedchem.5c03188","Year":2026,"Counterion":"[Cl-]","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"ER-Ir","value":0.31,"value_relation":"=","std":0.17,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.jmedchem.5c03188","year":2026,"counterion":"[Cl-]","record_id":"MLDB-004022","detection":"UV-Vis","method_description":"The lipophilicity and hydrophilicity of the Ir(III) complexes were determined by preparing octanolsaturated water (OSW) and water-saturated octanol (WSO) by mixing octanol and water. An aliquot of the stock solution of the Ir(III) complex in OSW was added to an equal volume of WSO and shaken at 100 rpm. After 24 h, the sample was centrifuged at 3000 rpm for 10 min. The aqueous and octanol layers were carefully separated into test tubes and analyzed by UV-vis spectroscopy. The lipid-water partition coefficient of the iridium complex was calculated using the following formula: Log Po/w = Log ([Ir]OSW / [Ir]WSO)."}]}