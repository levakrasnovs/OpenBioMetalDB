*10^-6)":14.5,"IC50_Dark_value":14.5,"Method":"MTT","DOI":"10.3390/ijms241511896","Year":2023,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-012426","value":">50","numeric":50}},{"Measurement_ID":"MCTM-013403","Abbreviation_in_the_article":"3c","Cell_line":"HeLa","Time(h)":24,"IC50_Dark(M*10^-6)":25.6,"IC50_Dark_value":25.6,"Method":"MTT","DOI":"10.1016/j.jinorgbio.2020.111099","Year":2020,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-013403","value":"20","numeric":20}},{"Measurement_ID":"MCTM-013404","Abbreviation_in_the_article":"3c","Cell_line":"MCF-7","Time(h)":24,"IC50_Dark(M*10^-6)":22.6,"IC50_Dark_value":22.6,"Method":"MTT","DOI":"10.1016/j.jinorgbio.2020.111099","Year":2020,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-013404","value":"11","numeric":11}},{"Measurement_ID":"MCTM-013405","Abbreviation_in_the_article":"3c","Cell_line":"HEK293","Time(h)":24,"IC50_Dark(M*10^-6)":88.6,"IC50_Dark_value":88.6,"Method":"MTT","DOI":"10.1016/j.jinorgbio.2020.111099","Year":2020,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-013405","value":"32.2","numeric":32.2}}],"logp":[{"abbreviation_in_the_article":"3c","value":0.3,"value_relation":"=","std":0.04,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.jinorgbio.2020.111099","year":2020,"counterion":"[Cl-]","record_id":"MLDB-000446","detection":"ICP-MS","method_description":"The log P of the compounds were determined via shake flask using the previously published procedure [10]. A known amount of each complex (3a-3u) was suspended in water (pre-saturated with n-octanol) and shaken for four days on an orbital shaker. To allow the phase separation, the solution was centrifuged for 10 min at 3000 rpm. Then the amount ruthenium present in saturated aqueous solution was measured by ICP-MS. To obtain the partition coefficient, different ratios (0.5 : 1, 1 : 1, and 2 : 1) of the saturated solutions were shaken with pre-saturated n-octanol for 20 min on an orbital shaker and followed the same procedure."},{"abbreviation_in_the_article":2,"value":-1.65,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.45% NaCl","temperature_C":37,"doi":"10.3390/ijms241511896","year":2023,"counterion":"[Cl-]","record_id":"MLDB-001492","detection":"UV-Vis","method_description":"The shake-flask method was used to measure Log p of 1–7. n-octanol and water containing 0.45% of sodium chloride were mutual saturated by stirring at 250 rpm for 24 h. The complex was dissolved in a mixture with equal volumes of pre-saturated n-octanol and water to a final concentration of 0.5 mM. The mixture was shaken at 250 rpm for 24 h at 37 °C and then centrifuged at 3000 rpm for 10 min. The complex concentration (C) in each phase was measured by UV-Vis spectroscopy and used to calculate Log p, according to the formula Log p = log (Coctanol/Cwater)."}]}