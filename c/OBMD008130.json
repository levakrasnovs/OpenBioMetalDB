0.14,"value_relation":"=","type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.1002/ejic.201201411","year":2013,"counterion":"[Br-]","record_id":"MLDB-004254","detection":"UV-Vis","method_description":"The n-octanol/water coefficients of the complexes were determined as previously reported60 by using a shake-flask method. PBS-buffered distilled water (100 mL, phosphate buffer [PO43–] = 10 mM, [NaCl] = 0.15 M, pH 7.4) and n-octanol (100 mL) were shaken together for 72 h to allow saturation of both phases. The complexes (1 mg) were mixed in aqueous and organic phase (1 mL), respectively, for 10 min. The resultant emulsion was centrifuged to separate the phases. The concentrations of the compound in each phase were determined by using UV absorbance spectroscopy. The value of log D7.4 was defined as [compound(organic)]/[compound(aqueous)]."}],"ccdc":["DIBWES"]}