_Dark(M*10^-6)":22.5,"IC50_Dark_value":22.5,"Method":"MTT","DOI":"10.1021/acs.inorgchem.4c05269","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-049102","value":"3.15","numeric":3.15}},{"Measurement_ID":"MCTM-049103","Abbreviation_in_the_article":"Picoplatin","Cell_line":"CT26.WT","Time(h)":72,"IC50_Dark(M*10^-6)":11.94,"IC50_Dark_value":11.94,"Method":"MTT","DOI":"10.1021/acs.inorgchem.4c05269","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-049103","value":"2.17","numeric":2.17}},{"Measurement_ID":"MCTM-049118","Abbreviation_in_the_article":"Picoplatin","Cell_line":"HCT-116","Time(h)":168,"IC50_Dark(M*10^-6)":3.39,"IC50_Dark_value":3.39,"Method":"clonogenic","DOI":"10.1021/acs.inorgchem.4c05269","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-049118","value":"0.82","numeric":0.82}},{"Measurement_ID":"MCTM-049119","Abbreviation_in_the_article":"Picoplatin","Cell_line":"CT26.WT","Time(h)":168,"IC50_Dark(M*10^-6)":2.9,"IC50_Dark_value":2.9,"Method":"clonogenic","DOI":"10.1021/acs.inorgchem.4c05269","Year":2025,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-049119","value":"0.46","numeric":0.46}},{"Measurement_ID":"MCTM-052062","Abbreviation_in_the_article":"picoplatin","Cell_line":"Neuro-2a","Time(h)":48,"IC50_Dark(M*10^-6)":2.2,"IC50_Dark_value":2.2,"Method":"MTT","Notes":"Seeding density (cells/well): 5000; Concentration basis: µM Pt; source one-Pt prodrug equivalents; Source dispersion label: SD error bars drawn but no numeric IC50 dispersion printed","DOI":"10.1016/j.nano.2016.08.024","Year":2016,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-052062","value":"4.2","numeric":4.2}}],"logp":[{"abbreviation_in_the_article":"picoplatin","value":-0.36,"value_relation":"=","std":0.05,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":25,"doi":"10.1002/slct.202400511","year":2024,"record_id":"MLDB-001726","detection":"UV-Vis","method_description":"The distribution of solutes in biphasic liquid systems has been an important area of research since the late 19th century. The octanol-water partition coefficient, Po/w, is a well-recognized physicochemical property that measures the hydrophobicity of a chemical.29 Po/w is the most widely used descriptor in quantitative structure-activity relationship (QSAR) studies.30 Drugs must cross four barriers related to absorption, distribution, metabolism and excretion called ADME interfaces. One of the core properties required to assess ADME properties is Po/w. The lipid-water partition coefficient of the drug was assayed in octanol/water system by standard shake flask method. Briefly, the complexes were dissolved in octanol to obtain solutions of 40, 60, 80, 100 and 120 μM and a standard curve was plotted based on the absorbance measured by UV/Vis. Next, the octanol solubilized sample to be tested (50 μM) was shaken at room temperature for 48 h. The mixed solution was centrifuged at 2500 rpm for 15 min to separate the two phases. The lipid phase concentration (Co) of the drug was calculated from the standard curve and the aqueous phase concentration (Cw) could be determined based on the principle of conservation of mass. The log P of the complex was calculated by equation 1: logP=log(Cw​/Co​​)"},{"abbreviation_in_the_article":"Picoplatin","value":-0.446,"value_relation":"=","std":0.029,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":25,"doi":"10.1002/aoc.6759","year":2022,"record_id":"MLDB-002090","detection":"UV-Vis","method_description":"The lipid-water partition coefficient was obtained by the standard shake flask method in the 1-octanol/ water system. In brief, the complexes were prepared with 1-octanol to obtain the solution of 20, 40, 60, 80, and 100 μM and drawing the standard curve according to the absorbance measured by UV/Vis. Next, the complex solutions (50 μM) prepared with an equal volume of 1-octanol/water saturated system were shaken at room temperature for 48 h. The mixed solutions were centrifuged at 2500 rpm/min for 15 min to separate the two phases. Determination of Cw used the absorbance of the lipid phase and a standard curve. The lipid phase concentration (Cw) could be obtained according to the absorbance of the lipid phase and the standard curve, and the water phase concentration (Co) could be determined by the principle of mass conservation. Obviously, the log P of the complexes was calculated by Equation (1)"}],"ccdc":["NUDGIC","TECWEE"]}