","Cell_line":"A2780","Time(h)":72,"IC50_Dark(M*10^-6)":19,"IC50_Dark_value":19,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015214","value":"2.5","numeric":2.5}},{"Measurement_ID":"MCTM-015215","Abbreviation_in_the_article":"[Ru(η6 -p-cym)(bpy)Cl]Cl","Cell_line":"A2780cisR","Time(h)":72,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1039/d1dt00808k","Year":2021,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-015215","value":"17","numeric":17}},{"Measurement_ID":"MCTM-019234","Abbreviation_in_the_article":5,"Cell_line":"A549","Time(h)":24,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1002/aoc.5171","Year":2019,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019234","value":"21.3","numeric":21.3}},{"Measurement_ID":"MCTM-019235","Abbreviation_in_the_article":5,"Cell_line":"HeLa","Time(h)":24,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1002/aoc.5171","Year":2019,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019235","value":"7.5","numeric":7.5}},{"Measurement_ID":"MCTM-019236","Abbreviation_in_the_article":5,"Cell_line":"HepG2","Time(h)":24,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1002/aoc.5171","Year":2019,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-019236","value":"22.7","numeric":22.7}},{"Measurement_ID":"MCTM-043261","Abbreviation_in_the_article":"RuB","Cell_line":"C6","Time(h)":24,"IC50_Dark(M*10^-6)":">40","IC50_Dark_value":40,"Method":"MTT","DOI":"10.3390/biom15040475","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-043262","Abbreviation_in_the_article":"RuB","Cell_line":"PC-12","Time(h)":24,"IC50_Dark(M*10^-6)":">40","IC50_Dark_value":40,"Method":"MTT","DOI":"10.3390/biom15040475","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":3,"value":0.21,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":37,"doi":"10.1016/j.jinorgbio.2015.07.016","year":2015,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000393","detection":"UV-Vis","method_description":"Water–octanol partition coefficients were determined using the stir-flask method [27]. Each complex was tested in a mixture of equal volumes of water and octanol with continuous shaking for 24 h at 100 rpm and 37 °C. Then the samples were centrifuged for 5 min at 300 rpm and the organic and aqueous phases were separated. The concentration of drug in each phase was measured spectrophotometrically in order to determine values of P = [drug](in octanol)/[drug](in water). The experiments were carried out in triplicate."},{"abbreviation_in_the_article":"3a","value":0.49,"value_relation":"=","std":0.03,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.jinorgbio.2020.111099","year":2020,"counterion":"[Cl-]","record_id":"MLDB-000444","detection":"ICP-MS","method_description":"The log P of the compounds were determined via shake flask using the previously published procedure [10]. A known amount of each complex (3a-3u) was suspended in water (pre-saturated with n-octanol) and shaken for four days on an orbital shaker. To allow the phase separation, the solution was centrifuged for 10 min at 3000 rpm. Then the amount ruthenium present in saturated aqueous solution was measured by ICP-MS. To obtain the partition coefficient, different ratios (0.5 : 1, 1 : 1, and 2 : 1) of the saturated solutions were shaken with pre-saturated n-octanol for 20 min on an orbital shaker and followed the same procedure."},{"abbreviation_in_the_article":"RuB","value":-1.9,"value_relation":"=","std":0.15,"type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.3390/biom15040475","year":2025,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-004456","detection":"UV-Vis","method_description":"A stock solution was prepared from each Ru complex using dimethyl sulfoxide (DMSO), then diluted to 6 mL and a concentration of 50 μM using phosphate-buffered saline (PBS, pH 7.4), where the final DMSO concentration was less than 5%. The absorbance spectra were measured, then 6 mL of 1-octanol was added, and the resulting biphasic sample was mixed at room temperature for 2 h using an IKA Trayster inversion mixer (60 rpm). Following this, the aqueous layer was extracted, and its absorbance spectra were measured. Log D values were determined using the equation below: LogD7.4 = log((Abs@λmax before mixing / Abs@λmax after mixing) - 1)"}],"ccdc":["FUPGAB","HOGPAV","HONCAR","XIKSUJ"]}