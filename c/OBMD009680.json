the_article":"Ru-4a","Cell_line":"primary human dermal fibroblasts","Time(h)":48,"IC50_Dark(M*10^-6)":6.36,"IC50_Dark_value":6.36,"Method":"SRB","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-037359","Abbreviation_in_the_article":"Ru-4a","Cell_line":"Capan-2","Time(h)":48,"IC50_Dark(M*10^-6)":2.6,"IC50_Dark_value":2.6,"Method":"SRB","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-037360","Abbreviation_in_the_article":"Ru-4a","Cell_line":"U2OS","Time(h)":48,"IC50_Dark(M*10^-6)":9.07,"IC50_Dark_value":9.07,"Method":"SRB","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-037361","Abbreviation_in_the_article":"Ru-4a","Cell_line":"L428","Time(h)":96,"IC50_Dark(M*10^-6)":17.16,"IC50_Dark_value":17.16,"Method":"Cell counting (Bürker chamber)","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-037362","Abbreviation_in_the_article":"Ru-4a","Cell_line":"A2780cisR","Time(h)":4,"IC50_Dark(M*10^-6)":11.43,"IC50_Dark_value":11.43,"Method":"MTT","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-037363","Abbreviation_in_the_article":"Ru-4a","Cell_line":"A2780cisR","Time(h)":48,"IC50_Dark(M*10^-6)":2.7,"IC50_Dark_value":2.7,"Method":"SRB","DOI":"10.3389/fchem.2025.1619991","Year":2025,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"Ru-2a","value":2.85,"value_relation":"=","type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.3390/ijms221910454","year":2021,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-001463","detection":"UV-Vis","method_description":"Prior to the experiments, n-octanol was saturated with aqueous PBS solution (pH = 7.40) and vice versa. The corresponding complex (approximately 0.2–0.3 mg) was dissolved in a mixture of 2.50 mL of pre-saturated n-octanol and 2.50 mL of pre-saturated PBS buffer, and the mixture was vigorously stirred for 3 days. According to the NMR stability measurements, this time was necessary to reach equilibrium between the various ionic complex species. Due to the lipophilic/hydrophilic character of the complexes, those with benzoyl protection or the non-sugar derivative could mostly be found in the n-octanol, while the acetyl and non-protected complexes could be found in the aqueous PBS phase. The appropriate separated solution was centrifuged (ScanSpeed 406G instrument, 4000 RPM for 5 min), and the absorption of the “stock solution” was measured (VWR UV-1600PC Spectrophotometer, 270–420 nm). Then 2.00 mL of stock solution was stirred vigorously with 16.00 mL of pre-saturated, clean n-octanol or PBS solution. After 1 day, the phases were separated and centrifuged, and the absorption of the solution was measured again. From the absorption difference of the stock solutions, the distribution coefficient (D) was calculated according to the previously described formulae [66]."},{"abbreviation_in_the_article":"Ru-4a","value":1.88,"value_relation":"=","type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"doi":"10.3389/fchem.2025.1619991","year":2025,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-001685","detection":"UV-Vis","method_description":"The distribution coefficient (logD) of the new complexes was determined using a 1:1 mixture of n-octanol-aq. PBS solution (pH = 7.4) according to our earlier published procedure (Kacsir et al., 2021)."}]}