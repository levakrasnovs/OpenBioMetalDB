n_in_the_article":"Ir3","Cell_line":"HEK293","Time(h)":48,"IC50_Dark(M*10^-6)":">100","IC50_Dark_value":100,"Method":"MTT","DOI":"10.1021/acs.organomet.6c00136","Year":2026,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"Ir3","value":2.03,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.organomet.6c00136","year":2026,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-004973","detection":"UV-Vis","method_description":"The partition coefficients (log PO/W) of Ir1-Ir3 were determined according to the literature. An equal volume of n-octanol and water was taken and mixed thoroughly overnight. After that, the solution was left undisturbed for 1 day, during which two immiscible layers of octanol and water was formed. Then, a small amount of the compound was added to the solution and mixed thoroughly using a shaker. The mixture was further centrifuged for 15-20 min and the two distinct phases were separated with the help of a separating funnel. Finally, the lipophilicities of the iridium complexes were estimated by measuring the absorbance in n-octanol and water, and the equation log PO/W = log (IO/IW) was used, where IO and IW represent the absorbance of complexes in n-octanol and water, respectively."}]}