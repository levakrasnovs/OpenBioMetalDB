.3,"Excitation_Wavelength(nm)":405,"Irradiation_Time(minutes)":5,"Irradiation_Power(W*m^-2)":200,"Method":"MTT","DOI":"10.1002/ejic.201601129","Year":2017,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-037817","value":"104.3 ± 4.5","numeric":104.3}},{"Measurement_ID":"MCTM-037818","Abbreviation_in_the_article":"Ir1","Cell_line":"HL-7702 (L-02)","Time(h)":2,"IC50_Light(M*10^-6)":"4.3 ± 0.2","IC50_Light_value":4.3,"Excitation_Wavelength(nm)":405,"Irradiation_Time(minutes)":5,"Irradiation_Power(W*m^-2)":200,"Method":"MTT","DOI":"10.1002/ejic.201601129","Year":2017,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-037818","value":"27.9 ± 1.7","numeric":27.9}}],"logp":[{"abbreviation_in_the_article":"Ir1","value":1.6,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"phosphate buffer","pH":7.01,"temperature_C":25,"doi":"10.1002/ejic.201601129","year":2017,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000193","detection":"ICP-MS","method_description":"The lipophilicity of each complex of the series (Log Po/w) was experimentally determined by the “shake-flask” method. Briefly, an aliquot of a stock solution of the iridium complex was diluted in the phosphate buffer (pH = 7.01, saturated with 1-octanol), and then the same volume of 1-octanol (previously saturated by the phosphate buffer) was added. Then, the mixture was shaken at 80 rpm for 12 h at 298 K to allow full distribution. After centrifugation at 2500 rpm for 5 min, the octanol layer was carefully removed. The Ir concentration in the aqueous phase was determined by ICP-MS after digestion of the aqueous phase with 65 % HNO3 for one day. The data was used to calculate the Log Po/w values by using the relevant equation in the literature.23"},{"abbreviation_in_the_article":"Ir2","value":0.04,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.jinorgbio.2022.111803","year":2022,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000499","method_description":"The lipophilicity of the complexes, which was referred to the n-octanol/water partition coefficient (log Po/w), was determined following a reported procedure. Log Po/w was calculated as the logarithmic ratio of complexes Ir2, Pt1–2, Ru1–2 concentration in n-octanol to that in the aqueous phase"},{"abbreviation_in_the_article":"Ir1","value":1.42,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","doi":"10.1039/c8sc04520h","year":2019,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-001206","method_description":"The lipophilicity of the iridium(III) complexes, which was presented as logPo/w values, was determined according to a reported procedure.8 LogPo/w is defined as the logarithmic ratio of Ir(III) concentration in n-octanol to that in the aqueous phase."}],"ccdc":["1584178","TITBEG","YEVGOY"]}