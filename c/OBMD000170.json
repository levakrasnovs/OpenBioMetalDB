7,"IC50_Dark_value":347,"Method":"Resazurin","DOI":"10.1016/j.jinorgbio.2022.111930","Year":2022,"Counterion":"O=S(=O)([O-])C(F)(F)F.O=S(=O)([O-])C(F)(F)F","Type":"IC50"},{"Measurement_ID":"MCTM-019033","Abbreviation_in_the_article":"Ru-1c","Cell_line":"NCI-H23","Time(h)":72,"IC50_Dark(M*10^-6)":">500","IC50_Dark_value":500,"Method":"Resazurin","DOI":"10.1016/j.jinorgbio.2022.111930","Year":2022,"Counterion":"O=S(=O)([O-])C(F)(F)F.O=S(=O)([O-])C(F)(F)F","Type":"IC50"}],"logp":[{"abbreviation_in_the_article":"Ru-1c","value":-0.69,"value_relation":"=","std":0.1,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1016/j.jinorgbio.2022.111930","year":2022,"counterion":"O=S(=O)([O-])C(F)(F)F.O=S(=O)([O-])C(F)(F)F","record_id":"MLDB-003374","detection":"UV-Vis","method_description":"The lipophilicity of the complexes was determined experimentally using the “shake flask” method. Nanopure water was used as the aqueous phase and 1-octanol was used as the organic phase. A 100 μM solution of the complex was prepared in 1-octanol and then mixed with and equal volume of water. The solution was shaken vigorously for 5 min and allowed to settle for 24 h while protected from light. The relative concentrations in the water and 1-octanol layers were determined spectrophometrically using a Cary 60 UV–Vis spectrophotometer. LogP was calculated using the absorbance in 1-octanol over the absorbance in water at the lambda max for each compound as follows: Ru-1a 455 nm; Ru-2a 460 nm; Ru-3a 465 nm; Ru-1b 475 nm; Ru-2b 470 nm; Ru-1c 370 nm; Ru-3c 470 nm."}]}