C50"}],"logp":[{"abbreviation_in_the_article":"Ru1","value":3.1,"value_relation":"=","std":0.3,"type_authors":"logD","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"temperature_C":25,"doi":"10.1016/j.jinorgbio.2023.112295","year":2023,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-000517","detection":"ICP-MS","method_description":"The logDo/w values were determined by the traditional shake flask method [35]. The phases of distilled PBS (PH = 7.4) and n-octanol were saturated with each other by stirring for 24 h prior to use. Briefly, Ru(II) complexes were added to the mixture of n-octanol/PBS aqueous solution (1:1, v/v), respectively. The mixture was shaken at 25 °C, 200 rpm for 24 h to achieve partitioning equilibrium between octanol and aqueous. The octanol and water phases were then separated by centrifugation (3000 rpm, 10 min) and collected. Take 100 μL of aqueous layer and 100 μL of octanol layer phase, put them into a centrifugal tube, and added 10% HNO3 and 20% H2O2 solution for digestion overnight. Finally, the Ru(II) content in the aqueous layer and octanol layer were measured by ICP-MS (NEXION-300×, PerkinElmer, USA) and used to calculate the LogDo/w values according to the equation LogDo/w = Log ([Ru]o/[Ru]w)."}]}