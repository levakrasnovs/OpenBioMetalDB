alue":8.2,"Method":"MTT","DOI":"10.1039/c5dt00169b","Year":2015,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-008194","value":"30.0","numeric":30}},{"Measurement_ID":"MCTM-008195","Abbreviation_in_the_article":5,"Cell_line":"Eca-109","Time(h)":48,"IC50_Dark(M*10^-6)":6.4,"IC50_Dark_value":6.4,"Method":"MTT","DOI":"10.1039/c5dt00169b","Year":2015,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-008195","value":"10.6","numeric":10.6}}],"logp":[{"abbreviation_in_the_article":5,"value":2.62,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":25,"doi":"10.1039/c5dt00169b","year":2015,"record_id":"MLDB-001081","detection":"UV-Vis","method_description":"Lipophilicity can be evaluated in various ways. The most common experimental lipophilicity measurement involves partitioning of a compound between octanol and aqueous solution (logP). UV-vis spectrophotometry was used for determining the concentration of the complex solution by a standard curve method. Octanol and distilled water were ultrasonically oscillated for 12 h at 25 °C to mutual saturation, standing and separating. 4 mL octanol, 5 mL distilled water and 1 mL complex octanol solution (complexes 1–5 of 1.1, 1.4, 1.2, 1.7 and 1.9 mg in 1 mL octanol, respectively) were added to a centrifugal tube (10 mL) and then ultrasonically oscillated for 30 min. After standing, 2 mL of solvent was extracted from the two phases respectively to be checked. The standard solution was prepared by using the double broth dilution method, and the standard curve was obtained from the linear analysis using Origin 7.5 (Fig. S4†)."}],"melting_points":[{"temperature_c":"214–215","event":"Melting point","Counterion":"","source":"10.1039/c5dt00169b","source_page":"PDF p. 3","notes":"5","url":"https://doi.org/10.1039/c5dt00169b"}]}