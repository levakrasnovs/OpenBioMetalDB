ion_in_the_article":"2a","Cell_line":"HL-7702 (L-02)","Time(h)":48,"IC50_Dark(M*10^-6)":54.8,"IC50_Dark_value":54.8,"Method":"MTT","DOI":"10.1016/j.ejmech.2024.116295","Year":2024,"Counterion":"F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-023883","value":"18.4","numeric":18.4}}],"logp":[{"abbreviation_in_the_article":"2a","value":0.2585,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":27,"doi":"10.1016/j.ejmech.2024.116295","year":2024,"counterion":"F[P-](F)(F)(F)(F)F","record_id":"MLDB-000374","detection":"UV-Vis","method_description":"The shake flash method was applied to test the octanol-water partition coefficient of the complexes in the organic and water phase. In brief, 1 mg/mL of 2a, 2b and 2c was added to the mixed solvent of octanol (1 mL) and H2O (1 mL), during 24 h, the solutions were continuously shaken at 300 K. Then the solutions were centrifuged at 1000 rpm for 15 minutes so that the organic and aqueous phases can be separated. UV–Vis spectra was applied to determine the complex concentration in the organic phases (Co), the concentration of the complexes in the H2O phase Cw = Ctotal – Co. The mean partition coefficient P values were calculated based on Log P = log(Co/Cw)."}]}