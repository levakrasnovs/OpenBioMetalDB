_id":"OBMD011700","measurement_id":"MCTM-011246","value":"37","numeric":37}},{"Measurement_ID":"MCTM-011247","Abbreviation_in_the_article":"POW-12A","Cell_line":"A2780","Time(h)":72,"IC50_Dark(M*10^-6)":12,"IC50_Dark_value":12,"Method":"SRB","DOI":"10.3389/fmolb.2023.1252285","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-011247","value":"2","numeric":2}},{"Measurement_ID":"MCTM-011248","Abbreviation_in_the_article":"POW-12A","Cell_line":"A2780-CP70","Time(h)":72,"IC50_Dark(M*10^-6)":35,"IC50_Dark_value":35,"Method":"SRB","DOI":"10.3389/fmolb.2023.1252285","Year":2023,"Counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-011248","value":"4","numeric":4}}],"logp":[{"abbreviation_in_the_article":"VNK-572","value":0.014,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"PBS","pH":7.4,"temperature_C":25,"doi":"10.3389/fmolb.2023.1252285","year":2023,"counterion":"F[P-](F)(F)(F)(F)F.F[P-](F)(F)(F)(F)F","record_id":"MLDB-001456","detection":"UV-Vis","method_description":"To study the lipophilicity of our complexes, we used the shake-flask method at 25.0ºC ± 0.1°C in line with the previously reported protocol (Dubey et al., 2017). Equal volumes of the aqueous phase (phosphate buffered saline, pH 7.4) and the 1-octanol phase were pre-saturated with each other overnight. A known amount of the complexes (respectively) was added to the aqueous phase, ensuring our final concentration was within the range of UV spectroscopic analysis; then, an equal volume of the pre-saturated ethanol phase was added. Both phases were then mixed in a conical flask and left shaking on a thermostatic shaker at a speed of 100 rpm overnight at room temperature. The mixture was then left to stand for 24 h to allow for phase separation. Considering that lipophilic compounds will partition into the octanol phase, the concentration of the complexes left in the aqueous phase was analyzed, respectively, by UV spectroscopy; then, the Log P value was calculated: Logp = Log10 ([solute] un-ionized octanol/[solute] un-ionized water)."}]}