OBMD011700","measurement_id":"MCTM-016301","value":"9.38","numeric":9.38}}],"logp":[{"abbreviation_in_the_article":"[Ru(dip)2(CH3bpy-COO)]+","value":1.857,"value_relation":"=","std":0.079,"type_authors":"logP","method":"shake-flask","aqueous_phase":"water","temperature_C":25,"doi":"10.1007/s00775-014-1187-5","year":2014,"counterion":"[Cl-]","record_id":"MLDB-001557","detection":"UV-Vis","method_description":"The lipophilicity of the ruthenium(II) complexes, which is referred to as log Po/w (n-octan-1-ol/water partition coefficient), was measured as follows. Ruthenium complexes were dissolved in n-octan-1-ol (to mM concentration), then solutions were added to water and the mixtures were stirred sufficiently for partitioning at 25 °C for 24 h. After that the mixtures were left for equilibration for another 2 h. The concentration of the compounds in the water phase was measured spectrophotometrically and Po/w value was calculated according to the equation: Po/w = (coctanol_before - cwater) / cwater where: coctanol_before = initial concentration of the ruthenium complex in octanol cwater = final concentration of the ruthenium complex in the water phase The experiment was conducted in triplicates."}]}