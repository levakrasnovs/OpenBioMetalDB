06409","Abbreviation_in_the_article":"mer,cis-[RuCl3(dbtp)2(dmso)]","Cell_line":"MCF-10A","Time(h)":72,"IC50_Dark(M*10^-6)":48.25,"IC50_Dark_value":48.25,"Method":"SRB","DOI":"10.1016/j.poly.2017.11.035","Year":2017,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-006409","value":"10.03","numeric":10.03}},{"Measurement_ID":"MCTM-006410","Abbreviation_in_the_article":"mer,cis-[RuCl3(dbtp)2(dmso)]","Cell_line":"BALB/3T3 clone A31","Time(h)":72,"IC50_Dark(M*10^-6)":66.01,"IC50_Dark_value":66.01,"Method":"SRB","DOI":"10.1016/j.poly.2017.11.035","Year":2017,"Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-006410","value":"12.23","numeric":12.23}}],"logp":[{"abbreviation_in_the_article":"mer,cis-[RuCl3(dbtp)2(dmso)]","value":0.8,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"0.9% NaCl","doi":"10.1016/j.poly.2017.11.035","year":2018,"record_id":"MLDB-000659","detection":"UV-Vis","method_description":"The lipophilicity of the mer,cis-[RuCl3(dbtp)2(dmso)] was determined using the shake-flask method [27]. Aqueous (0.9% v/v) sodium chloride and organic (n-octanol) phases were saturated for 1 week. The mer,cis-[RuCl3(dbtp)2(dmso)] was dissolved at a concentration of 0.30 mg mL-l in 2.5 mL of saturated organic phase. An equal volume of aqueous phase was added, and the solution was mechanically mixed in plastic tubes for 30 min, followed by centrifugation (6000 rpm, 15 min). Cisplatin was dissolved in the aqueous phase. After separation, the phases were analysed using UV–Vis spectroscopy to determine the amount of the compound in each phase. The absorption values before and after shaking were compared. The partition coefficient (log Po/w) in both phases for each compound was calculated based on the Lambert–Beer Law to determine the log Po/w values. The procedures were repeated ten times."}],"ccdc":["NEQYAM"]}