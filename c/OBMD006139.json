*m^-2)":150,"Method":"MTT","DOI":"10.1021/acs.inorgchem.5c05154","Year":2025,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-027280","value":"1.11 ± 0.10","numeric":1.11}},{"Measurement_ID":"MCTM-027281","Abbreviation_in_the_article":"Ir3","Cell_line":"A2780cisR","Time(h)":72,"IC50_Dark(M*10^-6)":"2.12 ± 0.06","IC50_Dark_value":2.12,"IC50_Light(M*10^-6)":"0.12 ± 0.005","IC50_Light_value":0.12,"Excitation_Wavelength(nm)":405,"Irradiation_Time(minutes)":8,"Irradiation_Power(W*m^-2)":150,"Method":"MTT","DOI":"10.1021/acs.inorgchem.5c05154","Year":2025,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-027281","value":"27.27 ± 0.70","numeric":27.27}},{"Measurement_ID":"MCTM-027282","Abbreviation_in_the_article":"Ir3","Cell_line":"HEK293","Time(h)":72,"IC50_Dark(M*10^-6)":"2.82 ± 0.24","IC50_Dark_value":2.82,"IC50_Light(M*10^-6)":"0.52 ± 0.03","IC50_Light_value":0.52,"Excitation_Wavelength(nm)":405,"Irradiation_Time(minutes)":8,"Irradiation_Power(W*m^-2)":150,"Method":"MTT","DOI":"10.1021/acs.inorgchem.5c05154","Year":2025,"Counterion":"[Cl-]","Type":"IC50","comparison":{"compound_id":"OBMD011700","measurement_id":"MCTM-027282","value":"25.75 ± 1.20","numeric":25.75}}],"logp":[{"abbreviation_in_the_article":"Ir3","value":1.24,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.jmedchem.3c00336","year":2023,"counterion":"[Cl-]","record_id":"MLDB-002241","detection":"UV-Vis","method_description":"The lipophilicity (log Po/w) of Pt-Biotin, Ir1-Ir3, Ir-Pt, and IriPlatins 1–3 was determined by the conventional flask-shaking method as reported in the literature. (35) Here, log Po/w = log (Co/Cw) is defined as the logarithmic ratio of the complexes concentration in n-octanol to that in the water phase. For this, 0.5 mg of complexes was taken in 3 mL of 1:1 v/v mixture of n-octanol and water and mixed vigorously for 24 h. The mixture was then kept in a stationary state for an additional 24 h to reach saturation. The n-octanol and water phases were separated and centrifuged at 3000 rpm for 10 min, and the supernatant was isolated. The concentrations of complexes were then determined by UV–vis spectroscopy in both the n-octanol (Co) and water (Cw) phases to estimate the log Po/w values."},{"abbreviation_in_the_article":"Ir3","value":1.11,"value_relation":"=","type_authors":"logP","method":"shake-flask","aqueous_phase":"water","doi":"10.1021/acs.inorgchem.5c05154","year":2025,"counterion":"[Cl-]","record_id":"MLDB-004001","detection":"UV-Vis","method_description":"The lipophilicity (log Po/w) of the complexes was determined using the traditional flask-shaking method. Briefly, 0.5 mg of each complex (Ir1–Ir5) was added to a 1:1 (v/v) mixture of n-octanol and water (3 mL) and shaken vigorously for 24 h. The mixture was then allowed to stand for another 24 h to reach phase equilibrium. After separation of the two layers, the concentrations of the complexes in the noctanol (Co) and aqueous (Cw) phases were quantified by UV–Vis spectroscopy. The partitioncoefficient was calculated as log Po/w = log [C]o/[C]w."}]}